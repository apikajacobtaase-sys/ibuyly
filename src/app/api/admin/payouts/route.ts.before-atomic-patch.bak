// src/app/api/admin/payouts/route.ts
import { db } from "@/lib/db";
import { NextResponse } from "next/server";
import { requireAdmin } from "@/lib/admin";
import { z } from "zod";

const UpdatePayoutSchema = z.object({
  payoutId: z.string().cuid("Invalid payout ID"),
  status: z.enum(["APPROVED", "PROCESSING", "PAID", "REJECTED", "FAILED"]),
  paymentReference: z.string().optional(),
  adminNotes: z.string().optional(),
  rejectionReason: z.string().optional(),
});

export async function GET(req: Request) {
  try {
    const { error } = await requireAdmin();
    if (error) return error;

    const { searchParams } = new URL(req.url);
    const status = searchParams.get("status");

    const whereClause = {
      ...(status && status !== "ALL" ? { status } : {}),
    };

    const payouts = await db.payout.findMany({
      where: whereClause,
      include: {
        seller: {
          select: {
            businessName: true,
            user: {
              select: {
                email: true,
              },
            },
          },
        },
      },
      orderBy: {
        createdAt: "desc",
      },
    });

    const formattedPayouts = payouts.map((p) => ({
      id: p.id,
      amount: Number(p.amount),
      currency: p.currency,
      status: p.status,
      paymentMethod: p.paymentMethod,
      paymentDetails: p.paymentDetails,
      adminNotes: p.notes,
      requestedAt: p.createdAt,
      processedAt: p.processedAt,
      paidAt: p.status === "PAID" ? p.processedAt : null,
      seller: {
        businessName: p.seller.businessName,
        email: p.seller.user.email,
      },
    }));

    return NextResponse.json({ payouts: formattedPayouts });
  } catch (error: unknown) {
    console.error("Admin payouts GET error:", error);

    return NextResponse.json(
      { error: "Failed to fetch payouts" },
      { status: 500 }
    );
  }
}

export async function PATCH(req: Request) {
  try {
    const { user, error } = await requireAdmin();
    if (error) return error;

    const body = await req.json();
    const validation = UpdatePayoutSchema.safeParse(body);

    if (!validation.success) {
      return NextResponse.json(
        {
          error: "Invalid request",
          details: validation.error.flatten(),
        },
        { status: 400 }
      );
    }

    const {
      payoutId,
      status,
      paymentReference,
      adminNotes,
      rejectionReason,
    } = validation.data;

    const payout = await db.payout.findUnique({
      where: { id: payoutId },
    });

    if (!payout) {
      return NextResponse.json(
        { error: "Payout not found" },
        { status: 404 }
      );
    }

    // Prevent repeated processing of an already-paid payout.
    if (payout.status === "PAID") {
      return NextResponse.json(
        { error: "This payout has already been marked as paid." },
        { status: 409 }
      );
    }

    const now = new Date();

    // Preserve existing payment details and add the reference.
    const existingDetails =
      payout.paymentDetails &&
      typeof payout.paymentDetails === "object" &&
      !Array.isArray(payout.paymentDetails)
        ? (payout.paymentDetails as Record<string, unknown>)
        : {};

    const paymentDetails =
      paymentReference || status === "PAID"
        ? {
            ...existingDetails,
            ...(paymentReference ? { paymentReference } : {}),
          }
        : undefined;

    // Preserve existing notes when adding a rejection reason.
    const notesParts = [
      adminNotes?.trim(),
      rejectionReason?.trim()
        ? `Rejection reason: ${rejectionReason.trim()}`
        : undefined,
    ].filter(Boolean);

    const updateData = {
      status,
      ...(status === "APPROVED" || status === "PROCESSING"
        ? { processedAt: payout.processedAt ?? now }
        : {}),
      ...(status === "PAID"
        ? {
            processedAt: payout.processedAt ?? now,
            processedBy: user?.id ?? undefined,
          }
        : {}),
      ...(paymentDetails ? { paymentDetails } : {}),
      ...(notesParts.length > 0
        ? {
            notes: [
              payout.notes,
              notesParts.join("\n"),
            ]
              .filter(Boolean)
              .join("\n"),
          }
        : {}),
    };

    const updatedPayout = await db.payout.update({
      where: { id: payoutId },
      data: updateData,
    });

    // Notify seller.
    let title = "";
    let message = "";

    if (status === "APPROVED") {
      title = "Your payout has been approved!";
      message = `Your payout of ${updatedPayout.currency} ${Number(
        updatedPayout.amount
      ).toFixed(2)} is being processed.`;
    } else if (status === "PROCESSING") {
      title = "Your payout is being processed";
      message = `Your payout of ${updatedPayout.currency} ${Number(
        updatedPayout.amount
      ).toFixed(2)} is being processed.`;
   } else if (status === "PAID") {
  title = "Your payout has been sent!";

  const savedDetails = updatedPayout.paymentDetails;

  const savedReference =
    savedDetails &&
    typeof savedDetails === "object" &&
    !Array.isArray(savedDetails) &&
    "paymentReference" in savedDetails
      ? String(savedDetails.paymentReference ?? "").trim()
      : "";

  const reference =
    paymentReference?.trim() || savedReference;

  message = `${updatedPayout.currency} ${Number(
    updatedPayout.amount
  ).toFixed(2)} has been marked as paid.${
    reference ? ` Payment reference: ${reference}.` : ""
  }`;
} else if (status === "REJECTED") {
      title = "Your payout request was rejected";
      message =
        rejectionReason?.trim() ||
        "Please contact support for more information.";
    } else if (status === "FAILED") {
      title = "Your payout failed";
      message =
        adminNotes?.trim() ||
        "Please contact support for more information.";
    }

     // Notify the seller using the existing Notification model.
if (title && message) {
  const seller = await db.sellerProfile.findUnique({
    where: { id: payout.sellerId },
    select: { userId: true },
  });

  if (seller?.userId) {
    await db.notification.create({
      data: {
        userId: seller.userId,
        sellerId: payout.sellerId,
        type: "SYSTEM",
        title,
        message,
        link: "/seller/payouts",
      },
    });
  }
}

    return NextResponse.json({
      success: true,
      message: "Payout updated successfully",
      payout: {
        id: updatedPayout.id,
        status: updatedPayout.status,
        processedAt: updatedPayout.processedAt,
        paymentDetails: updatedPayout.paymentDetails,
        notes: updatedPayout.notes,
      },
      notification: { title, message },
    });
  } catch (error: unknown) {
    console.error("Admin payouts PATCH error:", error);

    return NextResponse.json(
      { error: "Failed to update payout" },
      { status: 500 }
    );
  }
}

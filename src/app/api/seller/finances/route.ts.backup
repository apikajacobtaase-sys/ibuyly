import { db } from "@/lib/db";
import { getServerSession } from "next-auth";
import { NextResponse } from "next/server";
import { authOptions } from "@/lib/auth";
import { z } from "zod";

export const dynamic = "force-dynamic";

const PayoutRequestSchema = z.object({
amount: z.number().positive("Amount must be greater than 0"),
paymentMethod: z.enum(["BANK_TRANSFER", "MOBILE_MONEY"]),
paymentDetails: z.object({
accountName: z.string().min(2),
accountNumber: z.string().min(5),
bankName: z.string().min(2).optional(),
network: z.string().min(2).optional(),
}),
});

async function getSellerFinanceData(sellerId: string) {
const [records, payouts] = await Promise.all([
db.sellerFinancialRecord.findMany({
where: { sellerId },
orderBy: { createdAt: "desc" },
}),
db.payout.findMany({
where: { sellerId },
orderBy: { createdAt: "desc" },
}),
]);

const amountOf = (value: { toNumber(): number } | number) =>
typeof value === "number" ? value : value.toNumber();

const grossSales = records
.filter((record) => record.type === "SALE")
.reduce((sum, record) => sum + amountOf(record.amount), 0);

const marketplaceFees = Math.abs(
records
.filter((record) => record.type === "FEE")
.reduce((sum, record) => sum + amountOf(record.amount), 0)
);

const refunds = Math.abs(
records
.filter((record) => record.type === "REFUND")
.reduce((sum, record) => sum + amountOf(record.amount), 0)
);
const totalPaidOut = payouts
  .filter((payout) => payout.status === "PAID")
  .reduce((sum, payout) => sum + amountOf(payout.amount), 0);

// Signed SALE, FEE, and REFUND entries determine net earnings.
const netEarningsBeforePayouts = records.reduce((sum, record) => {
  if (
    record.type === "SALE" ||
    record.type === "FEE" ||
    record.type === "REFUND"
  ) {
    return sum + amountOf(record.amount);
  }

  return sum;
}, 0);

// Reserve requests that have not yet been paid.
const reservedPayouts = payouts
  .filter((payout) =>
    ["PENDING", "APPROVED", "PROCESSING"].includes(payout.status)
  )
  .reduce((sum, payout) => sum + amountOf(payout.amount), 0);

// Paid payouts are deducted once; pending payouts reserve the remainder.
const netEarnings = Math.max(
  0,
  netEarningsBeforePayouts - totalPaidOut
);

const availableBalance = Math.max(
  0,
  netEarnings - reservedPayouts
);


return {
grossSales: Number(grossSales.toFixed(2)),
marketplaceFees: Number(marketplaceFees.toFixed(2)),
netBalance: Number(netEarnings.toFixed(2)),
totalPaidOut: Number(totalPaidOut.toFixed(2)),
availableBalance: Number(availableBalance.toFixed(2)),
currency: "GHS",
records: records.slice(0, 100).map((record) => ({
id: record.id,
type: record.type,
amount: amountOf(record.amount),
description: record.description || record.type,
createdAt: record.createdAt.toISOString(),
})),
pendingPayouts: payouts
.filter((payout) =>
payout.status === "PENDING" || payout.status === "APPROVED"
)
.map((payout) => ({
id: payout.id,
amount: amountOf(payout.amount),
paymentMethod: payout.paymentMethod || "UNKNOWN",
status: payout.status,
createdAt: payout.createdAt.toISOString(),
})),
};
}

export async function GET() {
try {
const session = await getServerSession(authOptions);

if (!session?.user?.id) {
  return NextResponse.json(
    { error: "Unauthorized" },
    { status: 401 }
  );
}

const seller = await db.sellerProfile.findUnique({
  where: { userId: session.user.id },
  select: { id: true },
});

if (!seller) {
  return NextResponse.json(
    { error: "Seller profile not found" },
    { status: 403 }
  );
}

const finances = await getSellerFinanceData(seller.id);

return NextResponse.json(finances);

} catch (error) {
console.error("[SELLER FINANCES] GET error:", error);

return NextResponse.json(
  { error: "Failed to fetch seller finances" },
  { status: 500 }
);

}
}

export async function POST(req: Request) {
try {
const session = await getServerSession(authOptions);

if (!session?.user?.id) {
  return NextResponse.json(
    { error: "Unauthorized" },
    { status: 401 }
  );
}

const seller = await db.sellerProfile.findUnique({
  where: { userId: session.user.id },
  select: { id: true },
});

if (!seller) {
  return NextResponse.json(
    { error: "Seller profile not found" },
    { status: 403 }
  );
}

const parsed = PayoutRequestSchema.safeParse(await req.json());

if (!parsed.success) {
  return NextResponse.json(
    {
      error: "Invalid payout request",
      details: parsed.error.flatten(),
    },
    { status: 400 }
  );
}

const { amount, paymentMethod, paymentDetails } = parsed.data;

// Recalculate the seller's balance on the server.
const finances = await getSellerFinanceData(seller.id);

if (amount > finances.availableBalance + 0.000001) {
  return NextResponse.json(
    {
      error: "Insufficient available balance",
      availableBalance: finances.availableBalance,
      currency: "GHS",
    },
    { status: 400 }
  );
}

const payout = await db.payout.create({
  data: {
    sellerId: seller.id,
    amount,
    currency: "GHS",
    status: "PENDING",
    paymentMethod,
    paymentDetails,
  },
});

return NextResponse.json(
  {
    success: true,
    payoutId: payout.id,
    message: "Payout request submitted successfully",
  },
  { status: 201 }
);

} catch (error) {
console.error("[SELLER FINANCES] POST error:", error);

return NextResponse.json(
  { error: "Failed to request payout" },
  { status: 500 }
);


}
}

